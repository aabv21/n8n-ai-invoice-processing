# Postgres bootstrap superuser; only used to create the roles below. Generate
# secrets in this file with: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# n8n's own database role, and the app's database role used by workflows and scripts
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
APP_DB_USER=app
APP_DB_PASSWORD=

# n8n instance; N8N_API_KEY is from Settings -> n8n API, used by npm run cost
N8N_ENCRYPTION_KEY=
N8N_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_API_KEY=

# Anthropic and Google OAuth (shared by the Gmail, Drive, and Sheets credentials)
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Dev harness webhook token (localhost only; see AGENTS.md). Generate with: openssl rand -hex 24
DEV_HARNESS_TOKEN=
