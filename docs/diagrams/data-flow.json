  "cards": [
    {
      "dot": "cyan",
      "title": "What leaves the machine",
      "items": [
        "Only the PDF or its text goes to Anthropic, and the extracted fields come back",
        "Google receives the PDF and the rows the team reads",
        "Gmail carries the daily summary and error alerts"
      ]
    },
    {
      "dot": "emerald",
      "title": "What stays, and for how long",
      "items": [
        "Postgres holds the invoice, its items and every event, kept indefinitely",
        "n8n keeps each execution's data, including Gmail content, for 168 h",
        "config.json is a local file, mounted read-only"
      ]
    }
  ]
