  "cards": [
    {
      "dot": "cyan",
      "title": "Invoice path",
      "items": [
        "gmail-entry hands each poll to intake-email",
        "intake-email records each PDF once, then calls process-invoice",
        "The save comes first; Drive, Sheets, and the label follow"
      ]
    },
    {
      "dot": "violet",
      "title": "AI extraction",
      "items": [
        "Text path: Information Extractor with the Anthropic Chat Model",
        "PDF path: HTTP Request to the Messages API, structured output",
        "A failed check retries once on Sonnet 5.5, on the same path"
      ]
    },
    {
      "dot": "slate",
      "title": "Around the pipeline",
      "items": [
        "daily-summary emails the last 24 hours at 18:00 Bogota",
        "error-handler emails a plain-text alert when a workflow fails",
        "dev-harness takes POST /webhook/dev with X-Dev-Token"
      ]
    }
  ]
