{
  "id": "mgpLoadConfig001",
  "name": "Load config",
  "description": null,
  "nodes": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        -120,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Read config file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        180,
        200
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/config/config.json"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Parse config",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "data",
        "destinationKey": "config"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -60
      ],
      "parameters": {
        "width": 900,
        "height": 160,
        "content": "## Load config\nReads /files/config/config.json and parses it into { config }. Always Output Data is on for the read step, so a missing file still reaches the parse step as an item with no binary data, which throws instead of the branch silently stopping with zero items. Any failure here fires the error workflow."
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        440,
        380
      ],
      "parameters": {
        "width": 560,
        "height": 160,
        "content": "NOTE: Parse config keeps the caller's input fields alongside config instead of replacing them, because Extract From File's default Keep Source setting merges in the input item's JSON. So every caller passes no input. Upgrade path: add a Set node after Parse config that keeps only config, to match the documented output shape exactly."
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Read config file",
            "type": "main",
            "index": 0
          }
        ]
