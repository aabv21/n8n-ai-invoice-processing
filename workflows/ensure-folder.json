{
  "id": "mgpEnsureFolder1",
  "name": "Ensure folder",
  "description": null,
  "nodes": [
    {
      "id": "30000000-0000-4000-8000-000000000001",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        -160,
        280
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "parent_id",
              "type": "string"
            },
            {
              "name": "name",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000002",
      "name": "Find folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        140,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"name = '\" + $('When called').first().json.name + \"' and '\" + $('When called').first().json.parent_id + \"' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false\" }}",
        "returnAll": false,
        "limit": 1,
        "filter": {},
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "mgpCredGDrive001",
          "name": "Google Drive"
        }
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000003",
      "name": "Folder exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        400,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "30000000-0001-4000-8000-0000000a0101",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ !!$json.id }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000004",
      "name": "Create folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        420
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{ $('When called').first().json.name }}",
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('When called').first().json.parent_id }}"
        },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "mgpCredGDrive001",
          "name": "Google Drive"
        }
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000005",
      "name": "Return folder id",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        920,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "30000000-0002-4000-8000-0000000a0201",
              "name": "folder_id",
              "type": "string",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000006",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -80
      ],
      "parameters": {
        "width": 1200,
        "height": 160,
        "content": "## Ensure folder\nReturns the Drive folder id for name directly under parent_id, creating it first if it doesn't already exist. Find folder always returns an item, even on zero matches, so Folder exists? can tell \"not found\" from \"found\" instead of the branch silently stopping."
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000007",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        460
      ],
      "parameters": {
        "width": 500,
        "height": 180,
        "content": "NOTE: the query concatenates name and parent_id into the Drive query string with no quote escaping. Safe only because every caller passes digits (a year or month folder name) or a Drive-assigned id, never free text. Upgrade path: escape ' as \\' and \\ as \\\\ before interpolating, if a caller ever passes arbitrary text."
      }
    },
    {
      "id": "30000000-0000-4000-8000-000000000008",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        640,
        620
      ],
      "parameters": {
        "width": 500,
        "height": 180,
        "content": "NOTE: two concurrent first uploads in the same month can each find no folder and both create one, leaving two folders named the same mm. Ceiling: harmless at this demo's volume; queue mode under real concurrency still races here. Upgrade path: keep folder ids in Postgres and look them up with INSERT ... ON CONFLICT instead of asking Drive each time."
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Find folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find folder": {
      "main": [
        [
          {
            "node": "Folder exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Folder exists?": {
      "main": [
        [
          {
            "node": "Return folder id",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create folder": {
      "main": [
        [
          {
            "node": "Return folder id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "mgpErrorHandler1",
    "saveManualExecutions": false
  },
  "meta": null,
  "nodeGroups": [],
  "sourceWorkflowId": null,
  "tags": [],
  "versionMetadata": {
    "name": null,
    "description": null
  }
